{
  "name": "dsh-session-vault",
  "version": "1.4.0",
  "description": "Unofficial DSH plugin: choose where conversations live — the local default or any folder — with a recovery path that needs no session.",
  "license": "MIT",
  "author": "wodebilu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wodebilu/dsh-session-vault.git"
  },
  "homepage": "https://github.com/wodebilu/dsh-session-vault#readme",
  "bugs": {
    "url": "https://github.com/wodebilu/dsh-session-vault/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "usb",
    "portable",
    "session"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib/*.mjs"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/relocate-core.mjs",
    "test": "node --test --test-isolation=none \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
